{
	"modules": {
		"mail": {
			"settings": {
				"mailServers": [
					{ "smtp": "127.0.0.1", "port": "@MOCK_SMTP_PORT@", "username": "", "password": "", "ssl": false, "tls": false, "idleTimeout": "5000", "lifeTimeout": "5000" }
				],
				"spoolEnable": false,
				"spoolInterval": "0.05",
				"spoolStartDelayMinutes": "0"
			}
		},
		"bxLens": {
			"settings": {
				"bar": { "enabled": true, "access": @LENS_ACCESS@ },
				"console": {
					"enabled": true,
					"password": "lens-demo",
					"viewerPassword": "lens-view",
					"allowHeapDump": true,
					"access": @LENS_ACCESS@
				},
				"ai": {
					"enabled": @LENS_AI_ENABLED@,
					"provider": "ollama",
					"model": "@OLLAMA_MODEL@",
					"baseUrl": "@OLLAMA_URL@"
				},
				"collect": { "level": "full" },
				"store": { "flushSeconds": 5, "dir": "@STORE_DIR@", "instanceFolder": "web-a" },
				"ui": { "startOpen": false, "autoOpenOnException": true },
				"thresholds": { "slowQueryMs": 15, "slowRequestMs": 3000 },
				"request": { "maxMinutes": 1 },
				"history": { "trackNonHtml": true },
				"collectors": {
					"queries": { "includeParams": true },
					"orm": { "enabled": true },
					"mail": { "enabled": true, "capture": "full" },
					"functions": { "enabled": true, "max": 500 },
					"logs": { "enabled": true },
					"bifs": { "enabled": true },
					"aiobs": {
						"enabled": true, "attach": true, "content": "preview", "minCalls": 10,
						"prices": "{\"mock/mock-small\":{\"in\":0.15,\"out\":0.6},\"mock/mock-large\":{\"in\":3,\"out\":15}}"
					},
					"scopes": { "enabled": true, "url": true, "form": true, "session": true, "request": true }
				}
			}
		},
		"bxai": {
			"settings": {
				"provider": "ollama",
				"chatURL": "@OLLAMA_URL@",
				"defaultParams": { "model": "@OLLAMA_MODEL@" }
			}
		}
	},
	"executors": {
		"demo-pool": { "type": "fixed", "threads": 2, "description": "Small pool: the executor scenario saturates it" },
		"demo-workers": { "type": "fixed", "threads": 8, "description": "Healthy pool for comparison" },
		"demo-background": { "type": "cached", "description": "Cached pool: thread count grows with bursts" }
	},
	"watcher": {
		"definitions": {
			"global-config": {
				"paths": [ "@WATCH_DIR@/global" ],
				"listener": "demo.models.watchers.GlobalListener",
				"debounce": 250
			}
		}
	}
}
