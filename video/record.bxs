/**
 * Records the walkthrough of the demo. The narration (narration.json) is spoken first, so every segment's length is known; each segment drives
 * the browser for its sentences and the recorder keeps a log of when each segment really started, which the mixer uses to place the captions.
 *
 * Usage: BASE=http://127.0.0.1:8097 OUT=out CHROMIUM=/path/to/chrome boxlang record.bxs
 *   SHOTS=1  save a screenshot at the end of every segment into OUT (a quick check, with the waits cut short)
 *   ONLY=11-requests,12-errors  run only these segments (with SHOTS for a check of the selectors)
 */
videoDir  = getDirectoryFromPath( getCurrentTemplatePath() )
BASE      = getSystemSetting( "BASE", "http://127.0.0.1:8088" )
OUT       = createObject( "java", "java.io.File" ).init( getSystemSetting( "OUT", "out" ) ).getAbsolutePath()
SHOTS     = len( getSystemSetting( "SHOTS", "" ) ) > 0
ONLY      = listToArray( getSystemSetting( "ONLY", "" ) )
narration = jsonDeserialize( fileRead( videoDir & "narration.json" ) )
shell     = new lib.Shell()
logo      = "data:image/png;base64," & toBase64( fileReadBinary( videoDir & "assets/bxaudio-logo-full-dark-md.png" ) )

/** Scroll a few times, pausing between. */
function wheel( t, n, dy, every ) {
	for ( var i = 1; i <= n; i++ ) {
		t.wheel( 0, dy )
		t.wait( every )
	}
}

/** Type in the search box of the Requests page. */
function search( t, text ) {
	var box = 'input[placeholder^="Search URL"]:visible'
	t.fill( box, "" )
	t.glide( box )
	t.typeText( text, 70 )
	t.wait( 900 )
}

/** Ask Lensy a question: type it, send it, and let the answer stream in. */
function ask( t, q ) {
	t.glide( "textarea:visible" )
	t.typeText( q, 60 )
	t.wait( 400 )
	t.key( "Enter" )
	t.wait( 3000 )
}

/** Scroll the trace of an AI run into view. */
function showTrace( t ) {
	t.evalOn( "##obs-trace", "e => e.scrollIntoView( { block: 'start', behavior: 'smooth' } )" )
	t.wait( 1800 )
}

// What happens on screen for each segment. The runner holds the last frame until the voice has finished.
acts = {
