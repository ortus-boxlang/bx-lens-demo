		} )
		t.wait( 6000 )
	}
}

// -- The runner ---------------------------------------------------------------------------------------------------------------------------
t   = new lib.Recorder( BASE, OUT, "lens-demo", !SHOTS )
log = []
// The opening card is up from the start, before the first segment
t.go( "/index.bxm" )
t.card( { "t" : "<b>Bx</b>Lens", "s" : "Observability for BoxLang" } )
t.bug( { "s" : "Music by", "img" : logo } )
t.wait( 2000 )
if ( ONLY.len() && !ONLY.contains( "01-intro" ) ) {
	t.cardOff()
	t.bugOff()
	// A run of the console segments needs the console signed in
	if ( !ONLY.contains( "09-overview" ) && ONLY.filter( ( id ) => !reFind( "^(0|1[01]a?-|11b)", id ) ).len() ) {
		t.login()
	}
}
gap  = 1.1   // seconds of picture after the voice has finished
lead = 0.7   // seconds of picture before the voice starts
for ( seg in narration.segments ) {
	if ( ONLY.len() && !ONLY.contains( seg.id ) ) { continue }
	start = t.now()
	if ( seg.keyExists( "card" ) ) {
		t.card( seg.card )
		t.wait( seg.hold * 1000 )
		t.cardOff()
		t.wait( 500 )
		log.append( { "id" : seg.id, "start" : start, "voiceAt" : start, "voiceFor" : 0, "end" : t.now() } )
		continue
	}
	dur = shell.seconds( OUT & "/voice/" & seg.id & ".wav" )
	try {
		acts[ seg.id ]( t )
	} catch ( any e ) {
		println( "segment " & seg.id & " failed: " & e.message )
	}
	if ( SHOTS ) {
		t.shot( "s-" & seg.id )
	} else {
		rest = start + lead + dur + gap - t.now()
		if ( rest > 0 ) { t.wait( rest * 1000 ) }
	}
	log.append( { "id" : seg.id, "start" : start, "voiceAt" : start + lead, "voiceFor" : dur, "end" : t.now() } )
	println( seg.id & " start " & shell.fixed( start, 1 ) & " end " & shell.fixed( t.now(), 1 ) )
}
total = t.now()
t.close()
fileWrite( OUT & "/timeline.json", jsonSerialize( { "total" : total, "segments" : log } ) )
println( "total " & shell.fixed( total, 1 ) )
