<bx:output>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>#encodeForHTML( prc.pageTitle ?: "BxLens ColdBox demo" )#</title>
<style>
	body { font: 15px/1.5 system-ui, sans-serif; margin: 0; padding: 0 0 420px; color: ##1d2233; background: ##f6f8fc; }
	nav { background: ##303446; padding: 10px 24px; display: flex; gap: 16px; flex-wrap: wrap; }
	nav a { color: ##00dbff; text-decoration: none; font-size: 14px; }
	nav a.home { color: ##fff; font-weight: 600; }
	nav a.parent { margin-left: auto; color: ##aab; }
	main { max-width: 980px; margin: 24px auto; padding: 0 24px; }
	table { border-collapse: collapse; width: 100%; background: ##fff; }
	th, td { padding: 7px 10px; border-bottom: 1px solid ##e0e6f2; text-align: left; vertical-align: top; }
	code { background: ##e8edf6; padding: 1px 5px; border-radius: 3px; }
	.look { background: ##fff; border-left: 4px solid ##00a8c6; padding: 10px 16px; margin: 24px 0; }
	.look h2 { margin: 0 0 6px; font-size: 15px; }
	.btn { display: inline-block; padding: 4px 12px; border-radius: 4px; background: ##303446; color: ##fff; text-decoration: none; font-size: 13px; border: 0; cursor: pointer; }
	.btn.go { background: ##0b7285; } .btn.reset { background: ##b3261e; }
	.pill { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; background: ##e0e6f2; }
	.pill.err { background: ##ffd0cc; color: ##8a1c12; } .pill.slow { background: ##ffd8a8; color: ##7a3e00; } .pill.ok { background: ##d3f0dc; color: ##1e6b3a; }
	.warn { background: ##fff4e5; border: 1px solid ##ffd8a8; padding: 8px 14px; border-radius: 4px; }
	.err-box { background: ##fff; border-left: 4px solid ##b3261e; padding: 12px 16px; }
	small { color: ##667; }
</style>
</head>
<body>
<nav>
	<a class="home" href="#event.buildLink( 'main.index' )#">ColdBox demo</a>
	<a href="#event.buildLink( 'orders.index' )#">Orders</a>
	<a href="#event.buildLink( 'customers.index' )#">Customers</a>
	<a href="#event.buildLink( 'products.index' )#">Products</a>
	<a href="#event.buildLink( 'perf.slowView' )#">Slow views</a>
	<a href="#event.buildLink( 'errors.index' )#">Errors</a>
	<a href="#event.buildLink( 'schedulers.index' )#">Schedulers</a>
	<a href="/cbApp/public/index.bxm/reports/main/index">Reports</a>
	<a href="/cbApp/public/index.bxm/inventory/stock/index">Inventory</a>
	<a href="/cbApp/public/index.bxm/audit/log/index">Audit</a>
	<a href="/cbApp/public/index.bxm/faults/panel/index">Faults</a>
	<a class="parent" href="/index.bxm">Main demo</a>
	<a href="/~bxlens/index.bxm">BxLens console</a>
</nav>
<main>
#renderView()#
#renderView( 'partials/_look' )#
</main>
</body>
</html>
</bx:output>
