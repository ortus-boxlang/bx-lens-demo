/**
 * Copyright 2005-2007 ColdBox Framework by Luis Majano and Ortus Solutions, Corp
 * www.ortussolutions.com
 * ---
 * Application Bootstrap
 */
class{

	/**
	 * --------------------------------------------------------------------------
	 * Application Properties: Modify as you see fit!
	 * --------------------------------------------------------------------------
	 */
	this.name                 = "bxLensDemoColdBox";
	this.sessionManagement    = true;
	this.sessionTimeout       = createTimespan( 0, 1, 0, 0 );
	this.setClientCookies     = true;
	this.setDomainCookies     = true;
	this.timezone             = "UTC";
	this.whiteSpaceManagement = "smart";

	/**
	 * --------------------------------------------------------------------------
	 * Location Mappings
	 * --------------------------------------------------------------------------
	 * Mirrors the mappings from config/boxlang.json so the ColdBox sub-app is
	 * self-contained and does not depend on server-level configuration.
	 */
	_publicRoot = getDirectoryFromPath( getCurrentTemplatePath() );
	_cbRoot     = getDirectoryFromPath( _publicRoot.reReplace( "[/\\\\]$", "" ) );
	this.mappings[ "/app" ]                      = _cbRoot & "app";
	this.mappings[ "/public" ]                   = _publicRoot;
	this.mappings[ "/coldbox" ]                  = _cbRoot & "lib/coldbox";
	this.mappings[ "/coldbox/system/exceptions" ] = _cbRoot & "lib/coldbox/system/exceptions";
	this.mappings[ "/modules" ]                  = _cbRoot & "lib/modules";
	this.mappings[ "/testbox" ]                  = _cbRoot & "lib/testbox";
	this.mappings[ "/tests" ]                    = _cbRoot & "tests";

	/**
	 * --------------------------------------------------------------------------
	 * ColdBox Bootstrap Settings
	 * --------------------------------------------------------------------------
	 * Modify only if you need to, else default them.
	 * https://coldbox.ortusbooks.com/getting-started/configuration/bootstrapper-application.cfc
	 */
	// COLDBOX STATIC PROPERTY, DO NOT CHANGE UNLESS THIS IS NOT THE ROOT OF YOUR COLDBOX APP
	COLDBOX_APP_ROOT_PATH = _cbRoot & "app"
	// THE MAPPING LOCATION OF THE COLDBOX CORE APP
	COLDBOX_APP_MAPPING   = "/app"
	// THE WEB PATH LOCATION OF THE PUBLIC ASSETS, USUALLY "/" FOR MOST APPS
	// USE Empty String "" IF YOUR APP IS IN THE ROOT OF THE WEB
	// OR "/yourApp" IF YOUR APP IS IN A SUBFOLDER
	COLDBOX_WEB_MAPPING   = "/cbApp/public"
	// COLDBOX PROPERTIES
	COLDBOX_CONFIG_FILE   = ""
	// COLDBOX APPLICATION KEY OVERRIDE
	COLDBOX_APP_KEY       = ""
	// By default if an app is reiniting and a request hits it, we will fail fast with a message
	COLDBOX_FAIL_FAST = true

	/**
	 * --------------------------------------------------------------------------
	 * ORM + Datasource Settings
	 * --------------------------------------------------------------------------
	 */
	// In memory Derby, seeded at start by models.FixtureLoader from resources/data/*.json
	this.datasources[ "cbdemo" ] = {
		"driver"   : "derby",
		"protocol" : "memory",
		"database" : "cbdemo"
	};
	this.datasource = "cbdemo"

	/**
	 * --------------------------------------------------------------------------
	 * File watchers
	 * --------------------------------------------------------------------------
	 * One for each state BxLens can show, plain classes in app/models/watchers. They watch folders under DEMO_WATCH_DIR/cbapp
	 * (start.sh sets DEMO_WATCH_DIR). The watchers page writes files there.
	 */
	watchRoot = getSystemSetting( "DEMO_WATCH_DIR", getTempDirectory() & "bxlens-demo-watched" ) & "/cbapp";
	[ "orders-inbox", "settings", "slow", "failing", "chatty", "stopped" ].each( ( d ) => directoryCreate( watchRoot & "/" & d, true, true ) );
	this.watchers = {
		// Healthy: a struct listener that ingests dropped order files
		"orders-inbox" : {
			paths    : [ watchRoot & "/orders-inbox" ],
			debounce : 100,
			listener : {
				onCreate : ( event ) => new app.models.watchers.WatcherLog().add( "orders-inbox", "created", event.relativePath, fileRead( event.path ).listLen( char( 10 ) ) & " rows ingested" ),
				onModify : ( event ) => new app.models.watchers.WatcherLog().add( "orders-inbox", "modified", event.relativePath, "re-read" ),
				onDelete : ( event ) => new app.models.watchers.WatcherLog().add( "orders-inbox", "deleted", event.relativePath, "removed from the index" )
			}
		},
		// Debounced: one reload for a burst of saves
		"settings-reload" : { paths : [ watchRoot & "/settings" ], listener : "app.models.watchers.ConfigReloadListener", debounce : 1000, atomicWrites : true },
		// Slow listener: 3 seconds per event
		"slow-importer" : { paths : [ watchRoot & "/slow" ], listener : "app.models.watchers.SlowListener" },
		// Failing listener: stops itself after 5 errors in a row
		"failing-importer" : { paths : [ watchRoot & "/failing" ], listener : "app.models.watchers.FailingListener", errorThreshold : 5 },
		// Event storm: recursive, no debounce
		"chatty-assets" : { paths : [ watchRoot & "/chatty" ], listener : "app.models.watchers.ChattyListener", recursive : true, debounce : 0 }
	};

	/**
	 * Fires when the application starts
	 */
	public boolean function onApplicationStart() {
		bx:setting requestTimeout ="300";
		application.cbBootstrap= new coldbox.system.Bootstrap(
			COLDBOX_CONFIG_FILE,
			COLDBOX_APP_ROOT_PATH,
			COLDBOX_APP_KEY,
			COLDBOX_APP_MAPPING,
			COLDBOX_FAIL_FAST,
			COLDBOX_WEB_MAPPING
		)
		application.cbBootstrap.loadColdbox()
		// Registered but never started: the watchers page starts it
		watcherNew( name = "cb-stopped-watcher", paths = [ watchRoot & "/stopped" ], listener = "app.models.watchers.StoppedListener", force = true );
		return true
	}

	/**
	 * Fires when the application ends
	 *
	 * @appScope The app scope
	 */
	public void function onApplicationEnd( struct appScope ) {
		arguments.appScope.cbBootstrap.onApplicationEnd( arguments.appScope )
	}

	/**
	 * Process a ColdBox Request
	 *
	 * @targetPage The requested page
	 */
	public boolean function onRequestStart( string targetPage ) output=true{
		return application.cbBootstrap.onRequestStart( arguments.targetPage )
	}

	/**
	 * Fires on every session start
	 */
	public void function onSessionStart() {
		if ( !isNull( application.cbBootstrap ) ) {
			application.cbBootStrap.onSessionStart()
		}
	}

	/**
	 * Fires on session end
	 *
	 * @sessionScope The session scope
	 * @appScope     The app scope
	 */
	public void function onSessionEnd( struct sessionScope, struct appScope ) {
		arguments.appScope.cbBootStrap.onSessionEnd( argumentCollection = arguments )
	}

	/**
	 * On missing template handler
	 *
	 * @template
	 */
	public boolean function onMissingTemplate( template ) {
		return application.cbBootstrap.onMissingTemplate( argumentCollection = arguments )
	}

}
