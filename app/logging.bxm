<bx:script>
	request.pageTitle = "Logging";
	// One line at every level, to the application log and to a log named demo
	for ( level in [ "debug", "information", "warning", "error", "fatal" ] ) {
		writeLog( text = "Demo #level# line from /logging.bxm", type = level );
		writeLog( text = "Demo #level# line for the demo log", type = level, log = "demo" );
	}
	// ?flood=N writes N lines so the live tail has something to show
	flood = val( url.flood ?: 0 );
	for ( i = 1; i <= min( flood, 1000 ); i++ ) {
		writeLog( text = "Flood line #i# of #flood#", type = i % 7 == 0 ? "warning" : "information", log = "demo" );
	}
	request.lookAt = [
		"Console > Logs: pick application.log and demo.log, filter by level, search for 'Demo' or 'Flood', and turn on the live tail.",
		"Bar > Logs (the logs collector is on in this demo)."
	];
</bx:script>
<bx:include template="/includes/header.bxm" />
<bx:output>
<h1>Logging</h1>
<p>Wrote five lines to <code>application.log</code> and five to <code>demo.log</code>, one for each level.</p>
<p><a class="btn" href="/logging.bxm?flood=200">Write 200 more lines</a> <a class="btn" href="/logging.bxm?flood=1000">Write 1000 lines</a></p>
</bx:output>
<bx:include template="/includes/footer.bxm" />
