/**
 * BxLens demo application. A small shop plus a set of scenarios that each produce one kind of data BxLens can show:
 * N+1 queries, deadlocks, saturated executors, exhausted connection pools, memory growth, failing tasks and more.
 * Open the control panel at / to start and reset the scenarios.
 */
class {

	this.name              = "bxLensDemo";
	this.sessionManagement = true;
	this.mappings[ "/demo" ] = getDirectoryFromPath( getCurrentTemplatePath() );
	this.schedulers        = [ "demo.schedulers.DemoScheduler" ];

	// A deliberately small pool (5 connections, 2 second wait) so the pool exhaustion scenario shows up quickly
	this.datasources[ "demo" ] = {
		"driver"            : "derby",
		"protocol"          : "memory",
		"database"          : "lensdemo",
		"maxConnections"    : 5,
		"minConnections"    : 1,
		"connectionTimeout" : 2
	};
	this.datasource = "demo";

	// bx-orm (1.7.2 or later) when the module is installed. The Book entity lives in ormmodels.
	// announceQueryParams and generateStatistics are the app's to set: BxLens cannot force them.
	if ( createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getModuleService().hasModule( createObject( "java", "ortus.boxlang.runtime.scopes.Key" ).of( "orm" ) ) ) {
		this.mappings[ "/ormmodels" ] = getDirectoryFromPath( getCurrentTemplatePath() ) & "ormmodels";
		this.ormEnabled = true;
		this.ormSettings = {
			"datasource" : "demo", "entityPaths" : [ "/ormmodels" ], "dbcreate" : "update", "dialect" : "DerbyTenSevenDialect", "saveMapping" : false,
			"announceQueryParams" : false, "generateStatistics" : true
		};
	}

	// File watchers, one for each state BxLens can show. Each watches a folder under DEMO_WATCH_DIR (start.sh sets it to .run/watched).
	// The watchers page drops, edits and deletes files there. The global-config watcher is defined in boxlang.json instead.
	watchRoot = getSystemSetting( "DEMO_WATCH_DIR", getTempDirectory() & "bxlens-demo-watched" );
	[ "inbox", "config", "slow", "failing", "chatty", "stopped", "global" ].each( ( d ) => directoryCreate( watchRoot & "/" & d, true, true ) );
	this.watchers = {
		// Healthy: a struct listener that ingests dropped CSV files
		"inbox" : {
			paths     : [ watchRoot & "/inbox" ],
			debounce  : 100,
			listener  : {
				onCreate : ( event ) => {
					var rows = fileRead( event.path ).listLen( char( 10 ) );
					new demo.models.watchers.WatcherLog().add( "inbox", "created", event.relativePath, "#rows# rows ingested" );
				},
				onModify : ( event ) => new demo.models.watchers.WatcherLog().add( "inbox", "modified", event.relativePath, "re-read" ),
				onDelete : ( event ) => new demo.models.watchers.WatcherLog().add( "inbox", "deleted", event.relativePath, "removed from the index" )
			}
		},
		// Debounced: one reload for a burst of saves
		"config-reload" : { paths : [ watchRoot & "/config" ], listener : "demo.models.watchers.ConfigReloadListener", debounce : 1000, atomicWrites : true },
		// Slow listener: 3 seconds per event
		"slow-listener" : { paths : [ watchRoot & "/slow" ], listener : "demo.models.watchers.SlowListener" },
		// Failing listener: stops itself after 5 errors in a row
		"failing-listener" : { paths : [ watchRoot & "/failing" ], listener : "demo.models.watchers.FailingListener", errorThreshold : 5 },
		// Event storm: recursive, no debounce
		"chatty" : { paths : [ watchRoot & "/chatty" ], listener : "demo.models.watchers.ChattyListener", recursive : true, debounce : 0 }
	};

	function onApplicationStart() {
		// In-memory Derby can survive across application restarts inside the same JVM,
		// so guard every CREATE TABLE to keep onApplicationStart idempotent.
		try { queryExecute( "CREATE TABLE customers ( id INT PRIMARY KEY, name VARCHAR(80), country VARCHAR(2) )" ); } catch ( any e ) {}
		try { queryExecute( "CREATE TABLE orders ( id INT PRIMARY KEY, customer_id INT, total DECIMAL(10,2), status VARCHAR(20) )" ); } catch ( any e ) {}
		try { queryExecute( "CREATE TABLE numbers ( n INT PRIMARY KEY )" ); } catch ( any e ) {}
		// Re-seed only when the tables are empty (first start or after a manual wipe).
		if ( queryExecute( "SELECT COUNT(*) AS c FROM customers" ).c == 0 ) {
			var names = [ "Acme Freight", "Northwind Traders", "Globex", "Initech", "Umbrella Supply", "Hooli", "Stark Industries", "Wayne Logistics", "Wonka Foods", "Cyberdyne", "Soylent", "Tyrell Corp" ];
			var countries = [ "US", "GB", "DE", "FR", "CA", "AU" ];
			names.each( ( n, i ) => {
				queryExecute( "INSERT INTO customers VALUES ( :id, :name, :country )", { id : i, name : n, country : countries[ ( i - 1 ) % 6 + 1 ] } );
			} );
		}
		if ( queryExecute( "SELECT COUNT(*) AS c FROM orders" ).c == 0 ) {
			for ( var i = 1; i <= 30; i++ ) {
				queryExecute(
					"INSERT INTO orders VALUES ( :id, :cid, :total, :status )",
					{ id : 10400 + i, cid : ( i - 1 ) % 12 + 1, total : i * 37.5, status : i % 5 == 0 ? "shipped" : "open" }
				);
			}
		}
		if ( queryExecute( "SELECT COUNT(*) AS c FROM numbers" ).c == 0 ) {
			for ( var n = 1; n <= 160; n++ ) {
				queryExecute( "INSERT INTO numbers VALUES ( :n )", { n : n } );
			}
		}
		application.scenarios = new demo.models.Scenarios();
		application.aiDemo = new demo.models.AIDemo(
			port = val( getSystemSetting( "BOXLANG_DEMO_PORT", "8088" ) ),
			agentsEnabled = getSystemSetting( "WITH_AI", "" ) == "1"
		);
		application.aiDemo.registerServers();
		// Registered but never started: the watchers page starts it
		watcherNew(
			name = "stopped-watcher", paths = [ watchRoot & "/stopped" ], listener = "demo.models.watchers.StoppedListener", force = true
		);
		return true;
	}

	function onApplicationEnd() {
		if ( !isNull( application.scenarios ) ) {
			application.scenarios.resetAll();
		}
	}

}
